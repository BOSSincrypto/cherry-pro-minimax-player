<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Play triangle, optically centred on the 108x108 adaptive grid -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44,38 L74,54 L44,70 Z" />
    <!-- Glossy specular streak across the top of the triangle -->
    <path
        android:fillType="nonZero"
        android:pathData="M44,38 L74,54 L44,70 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="74"
                android:endY="70"
                android:startX="44"
                android:startY="38"
                android:type="linear">
                <item
                    android:color="#80FFFFFF"
                    android:offset="0.0" />
                <item
                    android:color="#00FFFFFF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
